---
import { VERSION_LABEL } from '../lib/version';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE, ANALYTICS_GOATCOUNTER } from '../config';
import { LANGS, DEFAULT_LANG, getLang } from '../i18n/config';
import { pathIn } from '../i18n/paths';
import { t, tPrefix } from '../i18n';
import { loadBook } from '../lib/book';
import { renderInline } from '../lib/render';

interface Props {
  lang: string;
  title: string;
  description: string;
  /** Ruta de la página sin el prefijo de idioma, p. ej. «capitulos/6-monte-carlo/». */
  path: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  current?: string;
  /**
   * false: la página no entra en el índice de búsqueda (el propio buscador, la 404) ni en los
   * buscadores de internet (noindex; también se quita del sitemap en astro.config.mjs).
   */
  searchable?: boolean;
}

const { lang, title, description, path, jsonLd, ogType = 'website', current, searchable = true } = Astro.props;
// Tipo de página para agrupar los resultados del buscador (RF-BUS-03).
const searchType = path.startsWith('capitulos/') ? 'chapter' : path.startsWith('temas/') ? 'topic'
  : /^glosario\/.+/.test(path) ? 'term' : path.startsWith('formulas/') ? 'formulas' : 'other';
const L = getLang(lang);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');
const canonical = new URL(u(`${lang}/${path}`), SITE.url).toString();
const book = loadBook(lang);
const ctx = { lang, base, book };
// Imagen para compartir (src/pages/[lang]/vista-previa/): la del capítulo, tema o Laboratorio, o la de portada.
const ogName = path.match(/^(?:capitulos|temas)\/([^/]+)\//)?.[1] ?? (path === 'laboratorio/' ? 'laboratorio' : 'portada');
const ogImage = new URL(u(`${lang}/vista-previa/${ogName}.png`), SITE.url).toString();
// Portada: «Título · Autor», para que el nombre del autor salga en los resultados de búsqueda.
const fullTitle = title === t(lang, 'site.bookTitle') ? `${title} · ${SITE.author}` : `${title} · ${t(lang, 'site.bookTitle')}`;
const uiStrings = tPrefix(lang, 'chapter.', 'ex.', 'py.', 'index.', 'chart.');
const nav = [
  { key: 'index', href: u(`${lang}/indice/`), label: t(lang, 'nav.index') },
  { key: 'glossary', href: u(`${lang}/glosario/`), label: t(lang, 'nav.glossary') },
  { key: 'formulas', href: u(`${lang}/formulas/`), label: t(lang, 'nav.formulas') },
  { key: 'lab', href: u(`${lang}/laboratorio/`), label: t(lang, 'nav.lab') },
  { key: 'about', href: u(`${lang}/sobre-el-libro/`), label: t(lang, 'nav.about') },
  { key: 'progress', href: u(`${lang}/progreso/`), label: t(lang, 'nav.progress') },
  { key: 'search', href: u(`${lang}/buscar/`), label: t(lang, 'nav.search') },
];
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={L.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.author} />
  {!searchable && <meta name="robots" content="noindex, follow" />}
  {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
  <link rel="canonical" href={canonical} />
  {LANGS.length > 1 && LANGS.map((l) => (
    <link rel="alternate" hreflang={l.htmlLang} href={new URL(u(`${l.code}/${pathIn(path, lang, l.code)}`), SITE.url).toString()} />
  ))}
  {LANGS.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(u(`${DEFAULT_LANG}/${pathIn(path, lang, DEFAULT_LANG)}`), SITE.url).toString()} />}
  <meta property="og:type" content={ogType} />
  {ogType === 'article' && <meta property="article:author" content={SITE.author} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={t(lang, 'site.bookTitle')} />
  <meta property="og:locale" content={L.locale.replace('-', '_')} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="manifest" href={u('manifest.webmanifest')} />
  <link rel="apple-touch-icon" href={u('icons/apple-touch-icon.png')} />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content={t(lang, 'site.name')} />
  <link rel="sitemap" href={u('sitemap-index.xml')} />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      try {
        var th = localStorage.getItem('quantlab:theme');
        if (th === 'light' || th === 'dark') d.setAttribute('data-theme', th);
        var fs = localStorage.getItem('quantlab:fs');
        if (fs) d.setAttribute('data-fs', fs);
      } catch (e) {}
    })();
  </script>
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  {ANALYTICS_GOATCOUNTER && <script is:inline async data-goatcounter={ANALYTICS_GOATCOUNTER} src="https://gc.zgo.at/count.js"></script>}
</head>
<body>
  <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href={u(`${lang}/`)}>
        <svg class="logo" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="8" fill="currentColor"/><polyline points="6,23 11,18 14,20 19,12 22,15 26,8" fill="none" stroke="var(--logo-ink, #fff)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="26" cy="8" r="2.4" fill="var(--logo-ink, #fff)"/></svg>
        <span>{t(lang, 'site.name')}</span>
      </a>
      <button class="nav-toggle js-only" type="button" aria-expanded="false" aria-controls="main-nav">{t(lang, 'nav.menu')}</button>
      <nav class="main-nav" id="main-nav" aria-label={t(lang, 'nav.main')}>
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
      {LANGS.length > 1 && (
        <ul class="lang-switch">
          {LANGS.filter((l) => l.code !== lang).map((l) => (
            <li><a href={u(`${l.code}/${pathIn(path, lang, l.code)}`)} hreflang={l.htmlLang} lang={l.htmlLang}><span aria-hidden="true">{l.code.toUpperCase()}</span><span class="sr-only">{l.name}</span></a></li>
          ))}
        </ul>
      )}
      <details class="settings js-only">
        <summary aria-label={t(lang, 'settings.label')} title={t(lang, 'settings.label')}><span aria-hidden="true">Aa</span></summary>
        <div class="settings-panel">
          <fieldset>
            <legend>{t(lang, 'settings.theme')}</legend>
            <div class="seg">
              <button type="button" data-theme-set="auto" aria-pressed="true">{t(lang, 'settings.themeAuto')}</button>
              <button type="button" data-theme-set="light" aria-pressed="false">{t(lang, 'settings.themeLight')}</button>
              <button type="button" data-theme-set="dark" aria-pressed="false">{t(lang, 'settings.themeDark')}</button>
            </div>
          </fieldset>
          <fieldset>
            <legend>{t(lang, 'settings.fontSize')}</legend>
            <div class="seg">
              <button type="button" data-fs-step="-1" aria-label={`A− (${t(lang, 'settings.smaller')})`}>A−</button>
              <button type="button" data-fs-step="1" aria-label={`A+ (${t(lang, 'settings.larger')})`}>A+</button>
            </div>
          </fieldset>
        </div>
      </details>
    </div>
  </header>
  <main id="main" class="page" tabindex="-1" data-pagefind-body={searchable ? '' : undefined} data-pagefind-meta={searchable ? `tipo:${searchType}` : undefined}>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <p class="disclaimer"><strong>{t(lang, 'footer.disclaimerTitle')}.</strong> <Fragment set:html={renderInline(book.disclaimer, ctx)} /></p>
      <ul class="footer-links">
        <li><a href={u(`${lang}/licencia/`)}>{t(lang, 'footer.license')}</a></li>
        <li><a href={u(`${lang}/privacidad/`)}>{t(lang, 'footer.privacy')}</a></li>
        <li><a href={u(`${lang}/aviso-legal/`)}>{t(lang, 'footer.legal')}</a></li>
        <li><a href={u(`${lang}/libro-completo/`)}>{t(lang, 'footer.fullBook')}</a></li>
        <li><a href={SITE.repo}>{t(lang, 'footer.source')}</a></li>
      </ul>
      <p style="margin:0">{t(lang, 'footer.licenseShort')} · {t(lang, 'site.bookTitle')}</p>
      <p class="site-version">{t(lang, 'footer.copyright', { year: SITE.copyrightYear, author: SITE.author })} · {t(lang, 'footer.version', { v: VERSION_LABEL })}</p>
    </div>
  </footer>
  <script type="application/json" id="ui-strings" set:html={JSON.stringify(uiStrings)} />
  <script>
    import '../lib/client/site';
  </script>
</body>
</html>
