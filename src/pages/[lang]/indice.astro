---
import Base from '../../layouts/Base.astro';
import { LANGS } from '../../i18n/config';
import { t } from '../../i18n';
import { loadBook } from '../../lib/book';
import { initRenderer, renderBlocks, chapterUrl, url, type RenderCtx } from '../../lib/render';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}

await initRenderer();
const { lang } = Astro.params as { lang: string };
const book = loadBook(lang);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const ctx: RenderCtx = { lang, base, book, linkTerms: false };
const extraLink: Record<string, string> = {
  formulas: url(ctx, `${lang}/formulas/`),
  glossary: url(ctx, `${lang}/glosario/`),
};
---
<Base lang={lang} title={t(lang, 'index.title')} description={t(lang, 'index.intro')} path="indice/" current="index">
  <div class="prose">
    <h1>{t(lang, 'index.title')}</h1>
    <p>{t(lang, 'index.intro')}</p>
    <ol class="book-index">
      {book.parts.map((p) => (
        <li id={`parte-${p.number}`}>
          <h2>Parte {p.roman} · {p.title}</h2>
          <p class="question">{p.question}</p>
          <ol>
            {p.chapters.map((n) => {
              const c = book.chapters.find((x) => x.number === n)!;
              const href = chapterUrl(ctx, n);
              return (
                <li class={href ? '' : 'unpublished'}>
                  <span class="num">{n}</span>
                  {href ? <a href={href}>{c.title}</a> : <span>{c.title}</span>}
                  {href
                    ? <span class="status" data-progress-of={`${lang}/${n}`} data-total={c.sections.length} hidden></span>
                    : <span class="soon">{t(lang, 'nav.comingSoon')}</span>}
                </li>
              );
            })}
          </ol>
        </li>
      ))}
      <li>
        <h2>{t(lang, 'index.topics')}</h2>
        <ol>
          {book.topics.map((tp) => (
            <li class="unpublished"><span class="num">{tp.letter}</span><span>{tp.title}</span><span class="soon">{t(lang, 'nav.comingSoon')}</span></li>
          ))}
        </ol>
      </li>
      <li>
        <h2>{t(lang, 'index.extra')}</h2>
        <ol>
          {book.extras.map((e) => (
            <li class={extraLink[e.key] ? '' : 'unpublished'}>
              {extraLink[e.key] ? <a href={extraLink[e.key]}>{e.title}</a> : <span>{e.title}</span>}
              {!extraLink[e.key] && <span class="soon">{t(lang, 'nav.comingSoon')}</span>}
            </li>
          ))}
        </ol>
      </li>
    </ol>
  </div>
</Base>
