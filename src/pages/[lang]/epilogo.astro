---
/** Epílogo · Por dónde seguir. */
import Base from '../../layouts/Base.astro';
import { LANGS } from '../../i18n/config';
import { t } from '../../i18n';
import { loadBook } from '../../lib/book';
import { initRenderer, renderBlocks, type RenderCtx } from '../../lib/render';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}

await initRenderer();
const { lang } = Astro.params as { lang: string };
const book = loadBook(lang);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const ctx: RenderCtx = { lang, base, book, headingShift: -1, usedTerms: new Set(), usedIds: new Set() };
const extra = book.extras.find((e) => e.key === 'epilogo');
if (!extra?.nodes) throw new Error('El libro no tiene «Epílogo».');
const html = renderBlocks(extra.nodes.filter((n) => n.type !== 'thematicBreak'), ctx);
---
<Base lang={lang} title={extra.title} description={t(lang, 'epilogue.description')} path="epilogo/">
  <article class="prose">
    <h1>{extra.title}</h1>
    <Fragment set:html={html} />
  </article>
</Base>
