---
// Raíz del sitio: lleva al idioma por defecto (y, cuando haya varios, al del navegador).
import { DEFAULT_LANG, LANGS } from '../i18n/config';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const target = `${base}${DEFAULT_LANG}/`;
const codes = LANGS.map((l) => l.code);
---
<!doctype html>
<html lang={DEFAULT_LANG}>
<head>
  <meta charset="utf-8" />
  <title>quantlab</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={target} />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <script is:inline define:vars={{ base, codes, target }}>
    var pref = (navigator.languages || [navigator.language || '']).map(function (l) { return String(l).slice(0, 2).toLowerCase(); });
    var hit = pref.find(function (p) { return codes.indexOf(p) >= 0; });
    location.replace(hit ? base + hit + '/' : target);
  </script>
</head>
<body><p><a href={target}>Fundamentos de finanzas cuantitativas</a></p></body>
</html>
