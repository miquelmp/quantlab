---
import Base from '../layouts/Base.astro';
import { DEFAULT_LANG } from '../i18n/config';
import { t } from '../i18n';
const lang = DEFAULT_LANG;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<Base lang={lang} title={t(lang, 'notfound.title')} searchable={false} description={t(lang, 'notfound.text')} path="404/">
  <div class="prose">
    <h1>{t(lang, 'notfound.title')}</h1>
    <p>{t(lang, 'notfound.text')}</p>
    <p><a class="btn btn-primary" href={`${base}${lang}/`}>{t(lang, 'nav.home')}</a> <a class="btn" href={`${base}${lang}/indice/`}>{t(lang, 'nav.index')}</a></p>
  </div>
</Base>
